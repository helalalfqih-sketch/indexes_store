# ============================================================================
# PRODUCTION ENVIRONMENT VARIABLES TEMPLATE
# ============================================================================

# ----------------------------------------------------------------------------
# 1. SUPABASE CONFIGURATION
# ----------------------------------------------------------------------------
VITE_SUPABASE_URL="https://your-project.supabase.co"
VITE_SUPABASE_ANON_KEY="your-supabase-anon-key"
VITE_SUPABASE_PROJECT_ID="your-project-id"

# Server-only key (Never expose to client bundles)
SUPABASE_SERVICE_ROLE_KEY="your-supabase-service-role-key"

# PostgreSQL Direct Connection String (For migrations & direct pooling)
DATABASE_URL="postgres://postgres:your-db-password@db.your-project.supabase.co:5432/postgres"

# ----------------------------------------------------------------------------
# 2. INTEGRATIONS (WhatsApp & Meta)
# ----------------------------------------------------------------------------
WHATSAPP_API_TOKEN="your-whatsapp-cloud-api-token"
WHATSAPP_PHONE_NUMBER_ID="your-whatsapp-phone-number-id"
WHATSAPP_BUSINESS_ACCOUNT_ID="your-whatsapp-business-account-id"
WHATSAPP_VERIFY_TOKEN="your-webhook-verify-token"

META_APP_ID="your-meta-app-id"
META_APP_SECRET="your-meta-app-secret"
META_PIXEL_ID="your-meta-pixel-id"

# ----------------------------------------------------------------------------
# 3. MONITORING & TELEMETRY (Sentry & Vercel)
# ----------------------------------------------------------------------------
VITE_SENTRY_DSN="https://your-sentry-dsn@o0.ingest.sentry.io/0"
SENTRY_AUTH_TOKEN="your-sentry-auth-token"
SENTRY_ORG="your-sentry-org"
SENTRY_PROJECT="indexes-store"

# ----------------------------------------------------------------------------
# 4. APP & SERVER CONFIG
# ----------------------------------------------------------------------------
VITE_APP_URL="https://your-app-domain.vercel.app"
NODE_ENV="production"


# ----------------------------------------------------------------------------
# 5. SHOPIFY HEADLESS CATALOG
# ----------------------------------------------------------------------------
# Set to "shopify" after adding the Storefront API token in the hosting provider.
CATALOG_SOURCE="supabase"
SHOPIFY_STORE_DOMAIN="ubhd8d-iz.myshopify.com"
SHOPIFY_STOREFRONT_ACCESS_TOKEN="your-storefront-access-token"
SHOPIFY_STOREFRONT_API_VERSION="2026-07"
