{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "tanstack-start",
  "cleanUrls": true,
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        },
        {
          "key": "X-XSS-Protection",
          "value": "1; mode=block"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        }
      ]
    }
  ],
  "redirects": [
    {
      "source": "/",
      "destination": "https://indexesstore.com/",
      "permanent": true
    },
    {
      "source": "/:path((?!api(?:/|$)|\\.well-known(?:/|$)|assets(?:/|$)|_build(?:/|$)|_serverFn(?:/|$)|~oauth(?:/|$)|mcp-authorize(?:/|$)|mcp-store-authorize(?:/|$)|auth(?:/|$)).*)",
      "destination": "https://indexesstore.com/:path*",
      "permanent": true
    }
  ]
}
