PORT=3000
ORIGIN=https://whatsapp-mcp.example.com
DATA_DIR=/data
LOG_LEVEL=info

# 32 random bytes encoded as base64. Encrypts WhatsApp linked-device auth state.
WA_SESSION_MASTER_KEY=

# At least 32 random characters. Signs OAuth codes and access/refresh tokens.
OAUTH_SIGNING_SECRET=

# Closed-by-default linking gate. A human enters this once on the OAuth page.
WA_LINK_INVITE_SECRET=

# Set true only if intentionally operating a public multi-user service.
ALLOW_PUBLIC_SIGNUP=false

# Comma separated. Redirects must use https and match one of these hosts.
OAUTH_REDIRECT_HOSTS=chatgpt.com
